{
  "description": "Halo — inject the using-halo skill at session start",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/halo-session-start",
            "statusMessage": "Loading Halo",
            "additionalContextLimit": 8000
          }
        ]
      }
    ]
  }
}
